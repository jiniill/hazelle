{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@protontech/crypto": ["./src/runtime/import/proton-crypto.d.ts"],
      "@protontech/crypto/*": ["./src/runtime/import/proton-crypto.d.ts"]
    },
    "noEmit": true
  }
}
