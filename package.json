{
  "name": "hazelle",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "HAZELLE_DATA=${HAZELLE_DATA:-.data} tsx watch src/server/node.ts",
    "css-types": "tcm -s -a -p \"src/app/**/*.module.css\"",
    "build": "npm run -s css-types && tsc -b && vite build && npm run -s build:server && scripts/source.sh",
    "build:server": "esbuild src/server/node.ts src/server/launch.ts src/server/frontend-worker.ts src/server/db/snapshot-worker.ts src/server/backup/restore-cli.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist/server --entry-names=[name] --external:undici --log-level=warning",
    "test": "vitest run",
    "check": "npm run -s css-types && tsc -b && eslint . && stylelint \"src/**/*.css\" && vitest run --reporter=dot",
    "brand": "node --experimental-strip-types brand/render.mjs",
    "e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.4.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource/gaegu": "5.3.0",
    "@fontsource/gowun-batang": "5.3.0",
    "@fontsource/gowun-dodum": "5.3.0",
    "@fontsource/hahmlet": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "@fontsource/nanum-myeongjo": "5.3.0",
    "@fontsource/nanum-pen-script": "5.3.0",
    "@fontsource/noto-sans-kr": "5.3.1",
    "@fontsource/noto-serif-kr": "5.3.1",
    "@lezer/highlight": "1.2.5",
    "@protontech/crypto": "2.2.0",
    "@protontech/drive-sdk": "0.23.0",
    "core-js": "3.50.0",
    "dompurify": "3.4.16",
    "fflate": "0.8.3",
    "gpt-tokenizer": "4.0.0",
    "hash-wasm": "4.12.0",
    "hono": "4.13.9",
    "katex": "0.18.9",
    "lucide-react": "1.48.0",
    "markdown-it": "15.0.2",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "undici": "^8.11.2",
    "wasmoon": "1.16.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hono/node-server": "^2.1.3",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "10.11.0",
    "fake-indexeddb": "^6.2.6",
    "msgpackr": "1.10.1",
    "stylelint": "17.15.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "tsx": "^4.23.15",
    "typed-css-modules": "0.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
